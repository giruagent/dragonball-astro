      <!-- Footer -->
      <footer class="py-8 text-center text-orange-300/60 text-sm border-t border-orange-500/20">
        <p>Dragon Ball Universe &copy; 2026 &mdash; A fan-made tribute</p>
      </footer>
    </main>
  </body>
  <script>
    // Quiz logic
    let score = 0;
    const buttons = document.querySelectorAll('.quiz-btn');
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const parent = btn.closest('.p-8');
        const isCorrect = btn.dataset.correct === 'true';
        if (isCorrect) {
          score++;
          btn.classList.add('bg-green-500/30', 'border-green-400');
        } else {
          btn.classList.add('bg-red-500/30', 'border-red-400');
          // Highlight correct answer
          parent.querySelectorAll('.quiz-btn').forEach(b => {
            if (b.dataset.correct === 'true') b.classList.add('bg-green-500/30', 'border-green-400');
          });
        }
        // Disable all buttons in this question
        parent.querySelectorAll('.quiz-btn').forEach(b => b.disabled = true);
      });
    });

    const scoreBtn = document.getElementById('quiz-score');
    const resultDiv = document.getElementById('quiz-result');
    if (scoreBtn && resultDiv) {
      scoreBtn.addEventListener('click', () => {
        const total = document.querySelectorAll('.quiz-btn[data-correct="true"]').length;
        resultDiv.textContent = `Tu puntaje: ${score}/${total}`;
        resultDiv.classList.remove('hidden');
      });
    }
  </script>
</html>
