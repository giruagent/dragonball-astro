---
import SiteHeader from '../components/SiteHeader.astro';
import DragonBallTrigger from '../components/DragonBallTrigger.astro';
import WarriorCard from '../components/WarriorCard.astro';
import QuizSection from '../components/QuizSection.astro';
import WishSection from '../components/WishSection.astro';
import LoreSections from '../components/LoreSections.astro';
import '../styles/global.css';

const warriors = [
  { name: 'Goku', title: 'El Saiyan que nunca se rinde', description: 'Saiyan criado en la Tierra. Corazón puro, apetito infinito y pasión por un buen combate.', color: '#ff9f1c', symbol: '悟', techniques: ['Kamehameha', 'Teletransportación'] },
  { name: 'Vegeta', title: 'Príncipe de todos los Saiyan', description: 'Orgulloso, incansable y siempre en busca del siguiente nivel. Su rivalidad los hace más fuertes.', color: '#71a9ff', symbol: '王', techniques: ['Final Flash', 'Galick Gun'] },
  { name: 'Gohan', title: 'Un estudioso con poder oculto', description: 'Un alma bondadosa cuya fuerza despierta cuando sus seres queridos están en peligro.', color: '#78dc8d', symbol: '飯', techniques: ['Masenko', 'Bestia'] },
  { name: 'Piccolo', title: 'El sabio namekiano', description: 'Estratega, mentor y guerrero cuya disciplina mantiene unido al equipo.', color: '#49c8a0', symbol: '魔', techniques: ['Makankosappo', 'Orange'] },
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#090b10" />
    <meta name="description" content="Un tributo hecho por fans a Dragon Ball: sus guerreros, aventuras inolvidables y un universo que nunca deja de sorprender." />
    <title>Dragon Ball — Un tributo de fans</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <SiteHeader />
    <main id="main">
      <section class="hero" id="top" aria-labelledby="hero-title">
        <div class="hero-content">
          <p class="eyebrow">Un tributo de fans a la leyenda</p>
          <h1 id="hero-title">La lucha<br />nunca <span>termina.</span></h1>
          <p class="hero-description">Desde una montaña tranquila hasta los confines del universo, toda gran aventura comienza con el valor de superar tus límites.</p>
          <div class="hero-actions"><a class="button button-primary" href="#warriors">Conoce a los guerreros <span aria-hidden="true">↗</span></a><a class="button button-secondary" href="#sagas">Explora las sagas</a></div>
          <p class="hero-meta">Siete deseos. Un universo inolvidable.</p>
        </div>
        <DragonBallTrigger number={1} placement="egg-hero" />
      </section>
      <section class="section warriors-section" id="warriors" aria-labelledby="warriors-title">
        <div class="section-heading"><p class="eyebrow">La última defensa de la Tierra</p><h2 id="warriors-title">Los guerreros Z</h2><p>Caminos distintos. Un solo equipo. Un universo que vale la pena proteger.</p></div>
        <div class="warriors-grid">{warriors.map((warrior, index) => <WarriorCard {...warrior} dragonBallNumber={index + 2} />)}</div>
        <p class="note">Descripciones creadas por fans. Las transformaciones y los niveles de poder varían según la saga.</p>
      </section>
      <LoreSections />
      <QuizSection />
      <WishSection />
    </main>
    <footer class="site-footer"><strong>DRAGON BALL · TRIBUTO DE FANS</strong><p>Hecho por fans, para fans. Dragon Ball y sus personajes pertenecen a sus respectivos creadores y titulares de derechos.</p><p class="dragonball-footer">Sin afiliación oficial. Sigue entrenando y soñando.</p></footer>
    <p class="dragon-ball-toast" id="dragon-ball-toast" role="status" aria-live="polite" aria-atomic="true"></p>
    <script>import '../scripts/site.js';</script>
  </body>
</html>
