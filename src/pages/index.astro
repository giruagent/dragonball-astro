          <div class="mt-8 text-center"><button id="quiz-score" class="px-8 py-4 bg-gradient-to-r from-orange-500 to-red-600 text-white font-bold rounded-full hover:scale-105 transition-transform shadow-lg shadow-orange-500/50">VER RESULTADO</button><div id="quiz-result" class="mt-4 text-2xl font-black text-orange-400 hidden"></div></div>
        </div>
      </section>

      <!-- Gallery Section -->
      <section class="py-24 px-4 bg-gradient-to-b from-transparent via-orange-950/10 to-transparent">
        <div class="max-w-6xl mx-auto">
          <h2 class="text-5xl font-black text-center text-orange-400 mb-4 tracking-tight">GALERÍA</h2>
          <p class="text-center text-orange-200/70 mb-16 text-lg">Momentos legendarios del universo Dragon Ball</p>
          <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
            <div class="relative overflow-hidden rounded-2xl aspect-square bg-gradient-to-br from-orange-900/40 to-black border border-orange-500/30 flex items-center justify-center group hover:scale-105 transition-transform"><span class="text-6xl relative z-10 group-hover:scale-125 transition-transform">🐉</span></div>
            <div class="relative overflow-hidden rounded-2xl aspect-square bg-gradient-to-br from-blue-900/40 to-black border border-blue-500/30 flex items-center justify-center group hover:scale-105 transition-transform"><span class="text-6xl relative z-10 group-hover:scale-125 transition-transform">⚡</span></div>
            <div class="relative overflow-hidden rounded-2xl aspect-square bg-gradient-to-br from-yellow-900/40 to-black border border-yellow-500/30 flex items-center justify-center group hover:scale-105 transition-transform"><span class="text-6xl relative z-10 group-hover:scale-125 transition-transform">⭐</span></div>
            <div class="relative overflow-hidden rounded-2xl aspect-square bg-gradient-to-br from-red-900/40 to-black border border-red-500/30 flex items-center justify-center group hover:scale-105 transition-transform"><span class="text-6xl relative z-10 group-hover:scale-125 transition-transform">🔥</span></div>
            <div class="relative overflow-hidden rounded-2xl aspect-square bg-gradient-to-br from-purple-900/40 to-black border border-purple-500/30 flex items-center justify-center group hover:scale-105 transition-transform"><span class="text-6xl relative z-10 group-hover:scale-125 transition-transform">💎</span></div>
            <div class="relative overflow-hidden rounded-2xl aspect-square bg-gradient-to-br from-green-900/40 to-black border border-green-500/30 flex items-center justify-center group hover:scale-105 transition-transform"><span class="text-6xl relative z-10 group-hover:scale-125 transition-transform">🧘</span></div>
          </div>
        </div>
