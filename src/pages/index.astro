---
// Dragon Ball themed landing page
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dragon Ball Universe</title>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { background: #0a0a0a; color: #fff; font-family: system-ui, -apple-system, sans-serif; overflow-x: hidden; }
      .min-h-screen { min-height: 100vh; }
      .bg-gradient-main { background: linear-gradient(180deg, #7c2d12 0%, #0a0a0a 40%, #0a0a0a 60%, #431407 100%); }
      .text-center { text-align: center; }
      .text-orange-400 { color: #fb923c; }
      .text-orange-300 { color: #fdba74; }
      .text-orange-200 { color: #fed7aa; }
      .text-orange-900 { color: #431407; }
      .font-black { font-weight: 900; }
      .font-bold { font-weight: 700; }
      .tracking-wider { letter-spacing: 0.1em; }
      .tracking-widest { letter-spacing: 0.3em; }
      .drop-shadow-glow { text-shadow: 0 0 30px rgba(255,140,0,0.8); }
      .relative { position: relative; }
      .absolute { position: absolute; }
      .inset-0 { top: 0; left: 0; right: 0; bottom: 0; }
      .z-10 { z-index: 10; }
      .bg-hero { background: url('https://images.unsplash.com/photo-1578662996442-48f60103fc96?w=1920') center/cover; opacity: 0.2; }
      .flex { display: flex; }
      .flex-col { flex-direction: column; }
      .flex-wrap { flex-wrap: wrap; }
      .items-center { align-items: center; }
      .justify-center { justify-content: center; }
      .justify-between { justify-content: space-between; }
      .gap-6 { gap: 1.5rem; }
      .gap-8 { gap: 2rem; }
      .grid { display: grid; }
      .grid-cols-1 { grid-template-columns: repeat(1, 1fr); }
      @media (min-width: 768px) { .md\:grid-cols-3 { grid-template-columns: repeat(3, 1fr); } .md\:grid-cols-2 { grid-template-columns: repeat(2, 1fr); } .md\:text-8xl { font-size: 6rem; } .md\:text-3xl { font-size: 1.875rem; } }
      @media (min-width: 1024px) { .lg\:grid-cols-4 { grid-template-columns: repeat(4, 1fr); } }
      .max-w-4xl { max-width: 56rem; }
      .max-w-6xl { max-width: 72rem; }
      .mx-auto { margin-left: auto; margin-right: auto; }
      .px-4 { padding-left: 1rem; padding-right: 1rem; }
      .py-4 { padding-top: 1rem; padding-bottom: 1rem; }
      .py-8 { padding-top: 2rem; padding-bottom: 2rem; }
      .py-20 { padding-top: 5rem; padding-bottom: 5rem; }
      .mt-2 { margin-top: 0.5rem; }
      .mt-4 { margin-top: 1rem; }
      .mt-8 { margin-top: 2rem; }
      .mt-12 { margin-top: 3rem; }
      .mb-3 { margin-bottom: 0.75rem; }
      .mb-4 { margin-bottom: 1rem; }
      .mb-12 { margin-bottom: 3rem; }
      .w-24 { width: 6rem; }
      .h-24 { height: 6rem; }
      .w-32 { width: 8rem; }
      .h-32 { height: 8rem; }
      .w-full { width: 100%; }
      .rounded-full { border-radius: 9999px; }
      .rounded-2xl { border-radius: 1rem; }
      .rounded-xl { border-radius: 0.75rem; }
      .rounded-lg { border-radius: 0.5rem; }
      .border { border-width: 1px; }
      .border-4 { border-width: 4px; }
      .border-orange-500\/30 { border-color: rgba(234,88,12,0.3); }
      .border-orange-200 { border-color: #fed7aa; }
      .border-yellow-500\/30 { border-color: rgba(234,179,8,0.3); }
      .border-blue-500\/30 { border-color: rgba(59,130,246,0.3); }
      .border-green-500\/30 { border-color: rgba(34,197,94,0.3); }
      .border-purple-500\/30 { border-color: rgba(168,85,247,0.3); }
      .border-red-500\/30 { border-color: rgba(239,68,68,0.3); }
      .border-t { border-top-width: 1px; }
      .border-orange-500\/20 { border-color: rgba(234,88,12,0.2); }
      .bg-orange-900\/50 { background: rgba(124,45,18,0.5); }
      .bg-blue-900\/50 { background: rgba(30,58,138,0.5); }
      .bg-green-900\/50 { background: rgba(20,83,45,0.5); }
      .bg-black\/50 { background: rgba(0,0,0,0.5); }
      .bg-orange-500 { background: #f97316; }
      .bg-orange-500\/20 { background: rgba(249,115,22,0.2); }
      .bg-orange-400 { background: #fb923c; }
      .bg-orange-300 { background: #fdba74; }
      .bg-orange-200 { background: #fed7aa; }
      .bg-gradient-to-br { background: linear-gradient(to bottom right, var(--tw-gradient-stops)); }
      .from-orange-300 { --tw-gradient-from: #fdba74; --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to); }
      .to-red-500 { --tw-gradient-to: #ef4444; }
      .from-orange-400 { --tw-gradient-from: #fb923c; --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to); }
      .to-yellow-300 { --tw-gradient-to: #fde047; }
      .from-blue-400 { --tw-gradient-from: #60a5fa; --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to); }
      .to-indigo-300 { --tw-gradient-to: #a5b4fc; }
      .from-green-400 { --tw-gradient-from: #4ade80; --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to); }
      .to-emerald-300 { --tw-gradient-to: #6ee7b7; }
      .shadow-glow { box-shadow: 0 0 30px rgba(255,140,0,0.8); }
      .shadow-glow-sm { box-shadow: 0 0 20px rgba(255,140,0,0.6); }
      .p-6 { padding: 1.5rem; }
      .inline-block { display: inline-block; }
      .block { display: block; }
      .text-2xl { font-size: 1.5rem; }
      .text-3xl { font-size: 1.875rem; }
      .text-4xl { font-size: 2.25rem; }
      .text-5xl { font-size: 3rem; }
      .text-6xl { font-size: 3.75rem; }
      .text-xl { font-size: 1.25rem; }
      .text-lg { font-size: 1.125rem; }
      .text-sm { font-size: 0.875rem; }
      .text-xs { font-size: 0.75rem; }
      .text-yellow-400 { color: #facc15; }
      .text-yellow-200 { color: #fef08a; }
      .text-yellow-200\/70 { color: rgba(254,240,138,0.7); }
      .text-blue-400 { color: #60a5fa; }
      .text-blue-200 { color: #bfdbfe; }
      .text-blue-200\/70 { color: rgba(191,219,254,0.7); }
      .text-blue-200\/80 { color: rgba(191,219,254,0.8); }
      .text-green-400 { color: #4ade80; }
      .text-green-200 { color: #bbf7d0; }
      .text-green-200\/70 { color: rgba(187,247,208,0.7); }
      .text-green-200\/80 { color: rgba(187,247,208,0.8); }
      .text-purple-400 { color: #c084fc; }
      .text-purple-200 { color: #e9d5ff; }
      .text-purple-200\/70 { color: rgba(233,213,255,0.7); }
      .text-red-400 { color: #f87171; }
      .text-red-200 { color: #fecaca; }
      .text-red-200\/70 { color: rgba(254,202,202,0.7); }
      .text-orange-200\/80 { color: rgba(254,215,170,0.8); }
      .text-orange-200\/60 { color: rgba(254,215,170,0.6); }
      .text-orange-300\/60 { color: rgba(253,186,116,0.6); }
      .hover\:scale-105:hover { transform: scale(1.05); }
      .hover\:bg-orange-400:hover { background: #fb923c; }
      .hover\:border-yellow-400:hover { border-color: #facc15; }
      .hover\:border-blue-400:hover { border-color: #60a5fa; }
      .hover\:border-green-400:hover { border-color: #4ade80; }
      .hover\:border-purple-400:hover { border-color: #c084fc; }
      .hover\:border-red-400:hover { border-color: #f87171; }
      .transition-all { transition: all 0.2s ease; }
      .transition-transform { transition: transform 0.2s ease; }
      .transition-colors { transition: border-color 0.2s ease; }
      .cursor-pointer { cursor: pointer; }
      .bg-blue-500\/20 { background: rgba(59,130,246,0.2); }
      .bg-green-500\/20 { background: rgba(34,197,94,0.2); }
      .bg-yellow-500\/20 { background: rgba(234,179,8,0.2); }
      .text-blue-300 { color: #93c5fd; }
      .text-green-300 { color: #86efac; }
      .from-indigo-900\/50 { background: rgba(49,46,129,0.5); }
      .from-blue-900\/50 { background: rgba(30,58,138,0.5); }
      .from-green-900\/50 { background: rgba(20,83,45,0.5); }
    </style>
  </head>
  <body>
    <main class="min-h-screen bg-gradient-main text-white">
      <!-- Hero Section -->
      <section class="relative flex flex-col items-center justify-center min-h-screen px-4">
        <div class="absolute inset-0 bg-hero"></div>
        <div class="relative z-10 text-center">
          <h1 class="text-6xl md:text-8xl font-black tracking-wider text-orange-400 drop-shadow-glow">
            DRAGON BALL
          </h1>
          <p class="mt-4 text-2xl md:text-3xl font-bold text-orange-200 tracking-widest">
            THE UNIVERSE AWAITS
          </p>
          <a href="#characters" class="inline-block mt-8 px-8 py-4 bg-orange-500 hover:bg-orange-400 text-black font-bold text-xl rounded-full transition-all hover:scale-105 shadow-glow-sm">
            EXPLORE CHARACTERS
          </a>
        </div>
      </section>

      <!-- Dragon Balls Section -->
      <section class="py-20 px-4">
        <h2 class="text-4xl font-bold text-center text-orange-300 mb-12">THE DRAGON BALLS</h2>
        <div class="flex flex-wrap justify-center gap-6 max-w-4xl mx-auto">
          <div class="w-24 h-24 rounded-full bg-gradient-to-br from-orange-300 to-red-500 shadow-glow flex items-center justify-center text-3xl font-black text-orange-900 border-4 border-orange-200">1</div>
          <div class="w-24 h-24 rounded-full bg-gradient-to-br from-orange-300 to-red-500 shadow-glow flex items-center justify-center text-3xl font-black text-orange-900 border-4 border-orange-200">2</div>
          <div class="w-24 h-24 rounded-full bg-gradient-to-br from-orange-300 to-red-500 shadow-glow flex items-center justify-center text-3xl font-black text-orange-900 border-4 border-orange-200">3</div>
          <div class="w-24 h-24 rounded-full bg-gradient-to-br from-orange-300 to-red-500 shadow-glow flex items-center justify-center text-3xl font-black text-orange-900 border-4 border-orange-200">4</div>
          <div class="w-24 h-24 rounded-full bg-gradient-to-br from-orange-300 to-red-500 shadow-glow flex items-center justify-center text-3xl font-black text-orange-900 border-4 border-orange-200">5</div>
          <div class="w-24 h-24 rounded-full bg-gradient-to-br from-orange-300 to-red-500 shadow-glow flex items-center justify-center text-3xl font-black text-orange-900 border-4 border-orange-200">6</div>
          <div class="w-24 h-24 rounded-full bg-gradient-to-br from-orange-300 to-red-500 shadow-glow flex items-center justify-center text-3xl font-black text-orange-900 border-4 border-orange-200">7</div>
        </div>
        <p class="text-center mt-8 text-orange-200 text-lg">Gather all seven and summon Shenron!</p>
      </section>

      <!-- Characters Section -->
      <section id="characters" class="py-20 px-4">
        <h2 class="text-4xl font-bold text-center text-orange-300 mb-12">LEGENDARY WARRIORS</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
          <!-- Goku Card -->
          <div class="bg-gradient-to-b from-orange-900/50 to-black border border-orange-500/30 rounded-2xl p-6 text-center hover:scale-105 transition-transform">
            <div class="w-32 h-32 mx-auto rounded-full bg-gradient-to-br from-orange-400 to-yellow-300 flex items-center justify-center text-5xl mb-4">🐉</div>
            <h3 class="text-2xl font-bold text-orange-400">GOKU</h3>
            <p class="mt-2 text-orange-200/80">Saiyan raised on Earth. Fights to protect the universe.</p>
            <div class="mt-4 inline-block px-4 py-1 bg-orange-500/20 text-orange-300 rounded-full text-sm">Super Saiyan</div>
          </div>
          <!-- Vegeta Card -->
          <div class="bg-gradient-to-b from-blue-900/50 to-black border border-blue-500/30 rounded-2xl p-6 text-center hover:scale-105 transition-transform">
            <div class="w-32 h-32 mx-auto rounded-full bg-gradient-to-br from-blue-400 to-indigo-300 flex items-center justify-center text-5xl mb-4">👑</div>
            <h3 class="text-2xl font-bold text-blue-400">VEGETA</h3>
            <p class="mt-2 text-blue-200/80">Prince of all Saiyans. Pride is his greatest strength.</p>
            <div class="mt-4 inline-block px-4 py-1 bg-blue-500/20 text-blue-300 rounded-full text-sm">Majin Vegeta</div>
          </div>
          <!-- Piccolo Card -->
          <div class="bg-gradient-to-b from-green-900/50 to-black border border-green-500/30 rounded-2xl p-6 text-center hover:scale-105 transition-transform">
            <div class="w-32 h-32 mx-auto rounded-full bg-gradient-to-br from-green-400 to-emerald-300 flex items-center justify-center text-5xl mb-4">🧘</div>
            <h3 class="text-2xl font-bold text-green-400">PICCOLO</h3>
            <p class="mt-2 text-green-200/80">Namekian warrior. Goku's greatest rival and ally.</p>
            <div class="mt-4 inline-block px-4 py-1 bg-green-500/20 text-green-300 rounded-full text-sm">Fusion</div>
          </div>
        </div>
      </section>

      <!-- Transformations Section -->
      <section class="py-20 px-4">
        <h2 class="text-4xl font-bold text-center text-orange-300 mb-12">TRANSFORMATIONS</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-6xl mx-auto">
          <div class="bg-black/50 border border-yellow-500/30 rounded-xl p-6 text-center hover:border-yellow-400 transition-colors">
            <div class="text-4xl mb-3">⭐</div>
            <h4 class="font-bold text-yellow-400">Super Saiyan</h4>
            <p class="text-sm text-yellow-200/70 mt-1">x50 power</p>
          </div>
          <div class="bg-black/50 border border-blue-500/30 rounded-xl p-6 text-center hover:border-blue-400 transition-colors">
            <div class="text-4xl mb-3">💎</div>
            <h4 class="font-bold text-blue-400">Super Saiyan Blue</h4>
            <p class="text-sm text-blue-200/70 mt-1">x20,000 power</p>
          </div>
          <div class="bg-black/50 border border-purple-500/30 rounded-xl p-6 text-center hover:border-purple-400 transition-colors">
            <div class="text-4xl mb-3">🌟</div>
            <h4 class="font-bold text-purple-400">Ultra Instinct</h4>
            <p class="text-sm text-purple-200/70 mt-1">Limitless</p>
          </div>
          <div class="bg-black/50 border border-red-500/30 rounded-xl p-6 text-center hover:border-red-400 transition-colors">
            <div class="text-4xl mb-3">🔥</div>
            <h4 class="font-bold text-red-400">Super Saiyan God</h4>
            <p class="text-sm text-red-200/70 mt-1">Divine power</p>
          </div>
        </div>
      </section>

      <!-- Power Comparison Section -->
      <section class="py-24 px-4">
        <div class="max-w-6xl mx-auto">
          <h2 class="text-5xl font-black text-center text-orange-400 mb-4 tracking-tight">PODER VS PODER</h2>
          <p class="text-center text-orange-200/70 mb-16 text-lg">Comparación de niveles de pelea</p>
          <div class="space-y-6 max-w-3xl mx-auto">
            <div class="p-6 rounded-2xl bg-gradient-to-r from-orange-900/40 to-black border border-orange-500/30">
              <div class="flex items-center justify-between mb-3"><span class="font-black text-orange-400 text-xl">GOKU (Ultra Instinct)</span><span class="text-orange-300 font-bold">150M+</span></div>
              <div class="w-full h-4 bg-black/60 rounded-full overflow-hidden"><div class="h-full bg-gradient-to-r from-orange-600 via-orange-400 to-yellow-300 rounded-full shadow-lg shadow-orange-500/50" style="width:100%"></div></div>
            </div>
            <div class="p-6 rounded-2xl bg-gradient-to-r from-blue-900/40 to-black border border-blue-500/30">
              <div class="flex items-center justify-between mb-3"><span class="font-black text-blue-400 text-xl">VEGETA (Blue Evolution)</span><span class="text-blue-300 font-bold">140M+</span></div>
              <div class="w-full h-4 bg-black/60 rounded-full overflow-hidden"><div class="h-full bg-gradient-to-r from-blue-600 via-blue-400 to-indigo-300 rounded-full shadow-lg shadow-blue-500/50" style="width:93%"></div></div>
            </div>
            <div class="p-6 rounded-2xl bg-gradient-to-r from-purple-900/40 to-black border border-purple-500/30">
              <div class="flex items-center justify-between mb-3"><span class="font-black text-purple-400 text-xl">JIREN</span><span class="text-purple-300 font-bold">135M+</span></div>
              <div class="w-full h-4 bg-black/60 rounded-full overflow-hidden"><div class="h-full bg-gradient-to-r from-purple-600 via-purple-400 to-pink-300 rounded-full shadow-lg shadow-purple-500/50" style="width:90%"></div></div>
            </div>
            <div class="p-6 rounded-2xl bg-gradient-to-r from-green-900/40 to-black border border-green-500/30">
              <div class="flex items-center justify-between mb-3"><span class="font-black text-green-400 text-xl">GOHAN (Beast)</span><span class="text-green-300 font-bold">100M+</span></div>
              <div class="w-full h-4 bg-black/60 rounded-full overflow-hidden"><div class="h-full bg-gradient-to-r from-green-600 via-green-400 to-emerald-300 rounded-full shadow-lg shadow-green-500/50" style="width:80%"></div></div>
            </div>
            <div class="p-6 rounded-2xl bg-gradient-to-r from-red-900/40 to-black border border-red-500/30">
              <div class="flex items-center justify-between mb-3"><span class="font-black text-red-400 text-xl">FREEZER (Golden)</span><span class="text-red-300 font-bold">85M+</span></div>
              <div class="w-full h-4 bg-black/60 rounded-full overflow-hidden"><div class="h-full bg-gradient-to-r from-red-600 via-red-400 to-orange-300 rounded-full shadow-lg shadow-red-500/50" style="width:70%"></div></div>
            </div>
            <div class="p-6 rounded-2xl bg-gradient-to-r from-cyan-900/40 to-black border border-cyan-500/30">
              <div class="flex items-center justify-between mb-3"><span class="font-black text-cyan-400 text-xl">PICCOLO (Orange)</span><span class="text-cyan-300 font-bold">75M+</span></div>
              <div class="w-full h-4 bg-black/60 rounded-full overflow-hidden"><div class="h-full bg-gradient-to-r from-cyan-600 via-cyan-400 to-teal-300 rounded-full shadow-lg shadow-cyan-500/50" style="width:65%"></div></div>
            </div>
          </div>
        </div>
      </section>

      <!-- Techniques Section -->
      <section class="py-24 px-4 bg-gradient-to-b from-transparent via-blue-950/10 to-transparent">
        <div class="max-w-6xl mx-auto">
          <h2 class="text-5xl font-black text-center text-orange-400 mb-4 tracking-tight">TÉCNICAS ICÓNICAS</h2>
          <p class="text-center text-orange-200/70 mb-16 text-lg">Los ataques más legendarios del universo</p>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="relative overflow-hidden rounded-2xl bg-gradient-to-b from-blue-900/40 to-black border border-blue-500/30 p-8 text-center hover:border-blue-400 transition-all hover:scale-105 group"><div class="absolute inset-0 bg-gradient-to-t from-blue-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div><div class="w-20 h-20 mx-auto rounded-full bg-gradient-to-br from-blue-400 to-cyan-300 flex items-center justify-center text-3xl mb-4 shadow-lg shadow-blue-500/40 animate-pulse-glow">🌊</div><h4 class="font-black text-blue-400 text-xl">KAMEHAMEHA</h4><p class="text-sm text-blue-200/70 mt-2">La ola de energía legendaria de la Escuela Tortuga</p><div class="mt-4 inline-block px-4 py-1 bg-blue-500/20 text-blue-300 rounded-full text-xs">Goku • Gohan • Krillin</div></div>
            <div class="relative overflow-hidden rounded-2xl bg-gradient-to-b from-purple-900/40 to-black border border-purple-500/30 p-8 text-center hover:border-purple-400 transition-all hover:scale-105 group"><div class="absolute inset-0 bg-gradient-to-t from-purple-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div><div class="w-20 h-20 mx-auto rounded-full bg-gradient-to-br from-purple-400 to-pink-300 flex items-center justify-center text-3xl mb-4 shadow-lg shadow-purple-500/40 animate-pulse-glow" style="animation-delay:0.3s">💥</div><h4 class="font-black text-purple-400 text-xl">FINAL FLASH</h4><p class="text-sm text-purple-200/70 mt-2">La técnica definitiva del Príncipe Vegeta</p><div class="mt-4 inline-block px-4 py-1 bg-purple-500/20 text-purple-300 rounded-full text-xs">Vegeta</div></div>
            <div class="relative overflow-hidden rounded-2xl bg-gradient-to-b from-yellow-900/40 to-black border border-yellow-500/30 p-8 text-center hover:border-yellow-400 transition-all hover:scale-105 group"><div class="absolute inset-0 bg-gradient-to-t from-yellow-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div><div class="w-20 h-20 mx-auto rounded-full bg-gradient-to-br from-yellow-400 to-orange-300 flex items-center justify-center text-3xl mb-4 shadow-lg shadow-yellow-500/40 animate-pulse-glow" style="animation-delay:0.6s">⚡</div><h4 class="font-black text-yellow-400 text-xl">SPIRIT BOMB</h4><p class="text-sm text-yellow-200/70 mt-2">La energía de todo el universo en una esfera</p><div class="mt-4 inline-block px-4 py-1 bg-yellow-500/20 text-yellow-300 rounded-full text-xs">Goku</div></div>
            <div class="relative overflow-hidden rounded-2xl bg-gradient-to-b from-red-900/40 to-black border border-red-500/30 p-8 text-center hover:border-red-400 transition-all hover:scale-105 group"><div class="absolute inset-0 bg-gradient-to-t from-red-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div><div class="w-20 h-20 mx-auto rounded-full bg-gradient-to-br from-red-400 to-orange-300 flex items-center justify-center text-3xl mb-4 shadow-lg shadow-red-500/40 animate-pulse-glow" style="animation-delay:0.9s">🔥</div><h4 class="font-black text-red-400 text-xl">BIG BANG ATTACK</h4><p class="text-sm text-red-200/70 mt-2">El ataque de energía concentrada de Vegeta</p><div class="mt-4 inline-block px-4 py-1 bg-red-500/20 text-red-300 rounded-full text-xs">Vegeta</div></div>
            <div class="relative overflow-hidden rounded-2xl bg-gradient-to-b from-cyan-900/40 to-black border border-cyan-500/30 p-8 text-center hover:border-cyan-400 transition-all hover:scale-105 group"><div class="absolute inset-0 bg-gradient-to-t from-cyan-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div><div class="w-20 h-20 mx-auto rounded-full bg-gradient-to-br from-cyan-400 to-teal-300 flex items-center justify-center text-3xl mb-4 shadow-lg shadow-cyan-500/40 animate-pulse-glow" style="animation-delay:1.2s">💫</div><h4 class="font-black text-cyan-400 text-xl">SPECIAL BEAM CANNON</h4><p class="text-sm text-cyan-200/70 mt-2">El rayo perforante de Piccolo</p><div class="mt-4 inline-block px-4 py-1 bg-cyan-500/20 text-cyan-300 rounded-full text-xs">Piccolo</div></div>
            <div class="relative overflow-hidden rounded-2xl bg-gradient-to-b from-green-900/40 to-black border border-green-500/30 p-8 text-center hover:border-green-400 transition-all hover:scale-105 group"><div class="absolute inset-0 bg-gradient-to-t from-green-500/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div><div class="w-20 h-20 mx-auto rounded-full bg-gradient-to-br from-green-400 to-emerald-300 flex items-center justify-center text-3xl mb-4 shadow-lg shadow-green-500/40 animate-pulse-glow" style="animation-delay:1.5s">🌿</div><h4 class="font-black text-green-400 text-xl">MASENKO</h4><p class="text-sm text-green-200/70 mt-2">El rayo de energía de Gohan</p><div class="mt-4 inline-block px-4 py-1 bg-green-500/20 text-green-300 rounded-full text-xs">Gohan</div></div>
